# Copy this file to .env and fill in real values. Never commit .env.

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Set DB_ENGINE=sqlite for a quick local run without MySQL installed.
# Leave as mysql (or unset) for the intended production setup.
DB_ENGINE=mysql
DB_NAME=quick_commerce_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
